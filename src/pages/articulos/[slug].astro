---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articulos', ({ data }) => data.published);
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article, allArticles: articles },
  }));
}

const { article, allArticles } = Astro.props;
const { Content } = await render(article);

const related = allArticles
  .filter((a) => a.slug !== article.slug && a.data.category === article.data.category)
  .slice(0, 2);

const shareUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<Layout title={article.data.title} description={article.data.excerpt}>
  <article class="section wrap articulo">
    <header class="articulo__head" data-reveal>
      <p class="eyebrow">{article.data.category}</p>
      <h1>{article.data.title}</h1>
      <div class="articulo__meta">
        <span>Por {article.data.author}</span>
        <span>{article.data.publishDate.toLocaleDateString('es-PE', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      </div>
    </header>

    <div class="articulo__body" data-reveal>
      <Content />
    </div>

    <div class="articulo__share" data-reveal>
      <a class="btn btn-secondary" href={`https://api.whatsapp.com/send?text=${encodeURIComponent(article.data.title + ' — ' + shareUrl)}`} target="_blank" rel="noopener noreferrer">
        Compartir por WhatsApp
      </a>
      <a class="btn btn-secondary" href="/contacto">Escribir a la agrupación</a>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section section--sunken">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <h2>También te puede interesar</h2>
        </div>
        <div class="grid grid-2">
          {related.map((item) => (
            <a class="card" href={`/articulos/${item.slug}`} data-reveal>
              <p class="article-card__category">{item.data.category}</p>
              <h3>{item.data.title}</h3>
              <p>{item.data.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .articulo {
    max-width: 44rem;
  }

  .articulo__head h1 {
    font-size: var(--text-3xl);
  }

  .articulo__meta {
    display: flex;
    gap: 1rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-top: 1rem;
  }

  .articulo__body {
    margin-top: 2.5rem;
    font-size: var(--text-lg);
    line-height: 1.75;
  }

  .articulo__body :global(h2) {
    font-size: var(--text-2xl);
    margin-top: 2em;
  }

  .articulo__body :global(p) {
    max-width: none;
    color: var(--text-primary);
  }

  .articulo__share {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .article-card__category {
    font-family: var(--font-subtitle);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0;
  }
</style>
