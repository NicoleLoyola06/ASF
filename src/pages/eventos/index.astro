---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const eventos = (await getCollection('eventos', ({ data }) => data.published)).sort(
  (a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf()
);

const beneficios = [
  { label: 'Aprendizaje', text: 'Contenido basado en evidencia, facilitado por nuestro equipo y aliados especialistas.' },
  { label: 'Networking', text: 'Conecta con otros jóvenes, educadores y organizaciones con intereses afines.' },
  { label: 'Educación sexual', text: 'Espacios seguros de información sobre salud sexual y reproductiva.' },
  { label: 'Acción social', text: 'Oportunidad de involucrarte directamente en intervenciones comunitarias.' },
];
---

<Layout
  title="Eventos"
  description="Charlas, talleres e intervenciones de Adolescencias Sin Ficciones en colegios y universidades del Perú."
  lineColor="var(--accent-energy-deep)"
>
  <section class="section wrap page-head">
    <h1 data-typewriter>Eventos y actividades</h1>
    <p>Espacios de educación y acción social para desmitificar la adolescencia.</p>
  </section>

  <section class="section wrap">
    {eventos.length === 0 ? (
      <div class="empty-state" data-reveal>
        <p>
          Todavía no hay eventos publicados. Estamos organizando nuestras próximas
          charlas e intervenciones en colegios y universidades: síguenos o
          escríbenos para enterarte primero.
        </p>
        <a href="/contacto" class="btn btn-primary">Proponer una actividad</a>
      </div>
    ) : (
      <div class="grid grid-3">
        {eventos.map((evento) => (
          <a class="card" href={`/eventos/${evento.slug}`} data-reveal>
            <h3>{evento.data.title}</h3>
            <p>{evento.data.summary}</p>
            <span class="field-hint">{evento.data.location}</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section section--sunken">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>Por qué asistir</h2>
      </div>
      <div class="grid grid-4">
        {beneficios.map((beneficio) => (
          <div class="beneficio-item" data-reveal>
            <span class="mark-circle beneficio-item__dot"></span>
            <h3>{beneficio.label}</h3>
            <p>{beneficio.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section cta-final">
    <div class="wrap" data-reveal>
      <h2>¿Quieres proponer una actividad?</h2>
      <p>Si tu colegio, universidad u organización quiere colaborar en un evento, cuéntanos tu idea.</p>
      <div class="btn-row">
        <a href="/contacto" class="btn btn-primary">Contactar a la agrupación</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    max-width: 44rem;
  }

  .page-head p {
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }

  .beneficio-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .beneficio-item__dot {
    width: 12px;
    height: 12px;
    background: var(--accent-soft);
  }
</style>
