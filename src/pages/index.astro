---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articulos', ({ data }) => data.published);
const featuredArticles = allArticles
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const upcomingEvents = (await getCollection('eventos', ({ data }) => data.published)).sort(
  (a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf()
);

const valores = [
  { label: 'Evidencia', text: 'Todo lo que comunicamos está respaldado por investigación y datos reales, no por suposiciones.' },
  { label: 'Compromiso', text: 'Actuamos con convicción en defensa activa de los derechos de los adolescentes.' },
  { label: 'Educación', text: 'Creemos que informar transforma personas, instituciones y sociedades.' },
  { label: 'Acción', text: 'Intervenimos activamente en colegios, universidades y espacios sociales para generar cambio real.' },
];

const servicios = [
  { label: 'Difusión en redes sociales', text: 'Contenido basado en evidencia para desmontar mitos sobre la adolescencia.', tint: 'naranja', featured: true },
  { label: 'Intervenciones educativas', text: 'Talleres y charlas en colegios y universidades del país.', tint: 'linea', featured: false },
  { label: 'Defensa de derechos humanos', text: 'Participación activa en espacios políticos y comunitarios.', tint: 'linea', featured: false },
  { label: 'Publicaciones e investigaciones', text: 'Artículos y columnas de opinión con rigor académico.', tint: 'beige', featured: true },
];

const impacto = [
  { label: 'Talleres realizados', value: '40+', icon: 'estrellas' },
  { label: 'Estudiantes alcanzados', value: '2,500+', icon: 'rombos' },
  { label: 'Instituciones asociadas', value: '15+', icon: 'capas' },
  { label: 'Artículos publicados', value: '50+', icon: 'flecha' },
];

// Bloque "por qué asistir": los pasos numerados de vwlab.io/pages/showcase
const razonesAsistir = [
  { n: '01', label: 'Evidencia, no opinión', text: 'Cada charla parte de investigación revisada, no de anécdotas ni de pánico moral.' },
  { n: '02', label: 'Diseñado con adolescentes', text: 'Somos estudiantes. El contenido se prueba con la misma edad a la que va dirigido.' },
  { n: '03', label: 'Adaptado a tu espacio', text: 'Colegio, universidad o comunidad: ajustamos duración, lenguaje y dinámica.' },
  { n: '04', label: 'Sin costo para la institución', text: 'Nuestro trabajo es voluntario. Lo que pedimos es el espacio y el tiempo.' },
];

const testimonios = [
  { quote: '"ASF cambió mi perspectiva sobre los adolescentes. Finalmente, alguien está hablando con evidencia."', author: 'María, educadora', role: 'Docente' },
  { quote: '"Necesitábamos esta voz. Los adolescentes merecemos ser escuchados sin prejuicios."', author: 'Carlos, 18 años', role: 'Estudiante' },
  { quote: '"Su trabajo es serio, riguroso y profundamente necesario para el Perú."', author: 'Dra. Patricia López', role: 'Psicóloga clínica' },
];
---

<Layout
  title="Inicio"
  description="Agrupación estudiantil peruana que desmitifica la adolescencia con evidencia científica, defensa de derechos y acción social."
>
  <!-- Hero: composición con la iconografía real del kit de marca (sin fotos, per manual) -->
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__copy above-marks" data-reveal>
        <p class="eyebrow">Agrupación estudiantil peruana</p>
        <h1>La adolescencia sin mitos, con evidencia.</h1>
        <p class="hero__subtext">
          Desmitificamos la adolescencia mediante investigación rigurosa, defensa activa de
          derechos y acción social transformadora. Trabajamos en colegios, universidades y
          espacios comunitarios para cambiar la narrativa sobre la juventud peruana.
        </p>
        <div class="btn-row">
          <a href="/proyectos" class="btn btn-primary">Conoce nuestros proyectos</a>
          <a href="/quienes-somos" class="btn btn-secondary">Conoce al equipo</a>
        </div>
      </div>

      <div class="hero__visual" aria-hidden="true">
        <img src="/images/brand/sol.png" alt="" class="brand-mark hero__sol" data-drift="-14" />
        <img src="/images/brand/mancha.png" alt="" class="brand-mark brand-mark--blend hero__mancha" data-drift="8" />
        <img src="/images/brand/estrellas.png" alt="" class="brand-mark brand-mark--blend hero__estrellas" data-drift="-22" />
        <img src="/images/brand/rombos.png" alt="" class="brand-mark brand-mark--blend hero__rombos" data-drift="18" />
      </div>
    </div>
  </section>

  <!-- Sobre nosotros: texto + cita real del Ideario -->
  <section class="section wrap sobre-nosotros">
    <div data-reveal>
      <h2>Sobre nosotros</h2>
      <p>
        Adolescencias Sin Ficciones nace de la convicción de que la adolescencia es
        una etapa profundamente mal comprendida en el Perú. Somos estudiantes
        universitarios que usamos la evidencia científica, la acción social y la
        defensa activa de derechos para cambiar esa narrativa.
      </p>
      <a href="/quienes-somos" class="btn btn-secondary">Conoce al equipo</a>
    </div>
    <blockquote class="pull-quote" data-reveal>
      <p>&ldquo;Ser adolescente en el Perú es difícil. Y la falta de comprensión sobre esta etapa lo hace aún más complejo.&rdquo;</p>
      <cite>— Ideario de Adolescencias Sin Ficciones</cite>
      <img src="/images/brand/esquina-roja.png" alt="" class="brand-mark pull-quote__esquina" />
    </blockquote>
  </section>

  <!-- Misión: manifiesto a sangre sobre beige -->
  <section class="section section--accent mision">
    <img src="/images/brand/estrellas.png" alt="" class="brand-mark brand-mark--blend brand-mark--hide-sm mision__marca" data-drift="-18" />
    <div class="wrap above-marks" data-reveal>
      <p class="eyebrow">Nuestra misión</p>
      <h2 class="mision__statement">
        Desmitificar la adolescencia mediante información basada en evidencia,
        promoviendo los derechos humanos de los adolescentes peruanos.
      </h2>
    </div>
  </section>

  <!-- Valores: incrustados dentro de la frase, al modo de untold.site -->
  <section class="section wrap valores-seccion">
    <div class="section-head" data-reveal>
      <h2>Lo que nos guía</h2>
    </div>

    <p class="valores-frase">
      Trabajamos con <span class="valor-chip">Evidencia</span>,
      <span class="valor-chip">Compromiso</span>,
      <span class="valor-chip">Educación</span> y
      <span class="valor-chip">Acción</span>. Cada pieza que publicamos pasa por esos cuatro filtros
      antes de salir.
    </p>

    <div class="grid grid-4 valores">
      {valores.map((valor) => (
        <div class="valor" data-reveal>
          <h3>{valor.label}</h3>
          <p>{valor.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Qué hacemos: bloque de tinta, el contrapunto oscuro de la página -->
  <section class="section section--ink que-hacemos">
    <img src="/images/brand/esquina-turquesa.png" alt="" class="brand-mark brand-mark--hide-sm que-hacemos__esquina" />
    <div class="wrap above-marks">
      <div class="section-head" data-reveal>
        <h2>¿Qué hacemos?</h2>
        <p>Nuestro trabajo se organiza en cuatro pilares estratégicos de cambio social y educativo.</p>
      </div>
      <div class="servicios-grid">
        {servicios.map((servicio) => (
          <div class={`servicio servicio--${servicio.tint} ${servicio.featured ? 'servicio--featured' : ''}`} data-reveal>
            <h3>{servicio.label}</h3>
            <p>{servicio.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Impacto: cifras que cuentan al entrar en pantalla -->
  <section class="section wrap impacto">
    <div class="section-head" data-reveal>
      <h2>Nuestro impacto</h2>
      <p>Desde nuestro inicio, hemos alcanzado estudiantes, educadores e instituciones en todo el Perú con trabajo riguroso y transformador.</p>
    </div>
    <div class="impacto-grid">
      {impacto.map((item) => (
        <div class="impacto-card" data-reveal>
          <div class="impacto-card__icon">
            <img src={`/images/brand/${item.icon}.png`} alt="" />
          </div>
          <p class="impacto-card__value">{item.value}</p>
          <p class="impacto-card__label">{item.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Eventos: pasos numerados (vwlab.io) en vez de un estado vacío mudo -->
  <section class="section section--sunken eventos">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>Próximos eventos y actividades</h2>
        <p>Llevamos charlas e intervenciones a colegios, universidades y espacios comunitarios de todo el país.</p>
      </div>

      {upcomingEvents.length > 0 && (
        <div class="grid grid-3 eventos__lista">
          {upcomingEvents.slice(0, 3).map((event) => (
            <a class="card" href={`/eventos/${event.slug}`} data-reveal>
              <h3>{event.data.title}</h3>
              <p>{event.data.summary}</p>
            </a>
          ))}
        </div>
      )}

      <h3 class="pasos__titulo" data-reveal>¿Por qué invitarnos?</h3>
      <ol class="pasos">
        {razonesAsistir.map((razon) => (
          <li class="paso">
            <span class="paso__n">{razon.n}</span>
            <h4>{razon.label}</h4>
            <p>{razon.text}</p>
          </li>
        ))}
      </ol>

      <div class="eventos__cta" data-reveal>
        {upcomingEvents.length === 0 && (
          <p class="eventos__nota">
            Todavía no hay fechas publicadas. Estamos coordinando las próximas actividades.
          </p>
        )}
        <a href="/contacto" class="btn btn-energy">Proponer una actividad</a>
      </div>
    </div>
  </section>

  <!-- Artículos destacados -->
  <section class="section wrap articulos-seccion">
    <img src="/images/brand/rombos.png" alt="" class="brand-mark brand-mark--blend brand-mark--hide-sm articulos__marca" data-drift="-16" />
    <div class="section-head above-marks" data-reveal>
      <h2>Nuestras publicaciones más recientes</h2>
      <p>Investigación, análisis y evidencia sobre la adolescencia peruana.</p>
    </div>
    <div class="grid grid-3 above-marks">
      {featuredArticles.map((article) => (
        <a class="card article-card" href={`/articulos/${article.slug}`} data-reveal>
          <p class="article-card__category">{article.data.category}</p>
          <h3>{article.data.title}</h3>
          <p>{article.data.excerpt}</p>
          <span class="article-card__author">Por {article.data.author}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Testimonios -->
  <section class="section section--sunken">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>Lo que dicen de nuestro trabajo</h2>
        <p>Educadores, estudiantes e investigadores comparten cómo ASF está transformando conversaciones sobre la adolescencia en el Perú.</p>
      </div>
      <div class="testimonios-grid">
        {testimonios.map((testimonio) => (
          <div class="testimonio-card" data-reveal>
            <p class="testimonio-card__quote">{testimonio.quote}</p>
            <div class="testimonio-card__author">
              <p class="testimonio-card__name">{testimonio.author}</p>
              <p class="testimonio-card__role">{testimonio.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="section section--ink cta-final">
    <img src="/images/brand/sol.png" alt="" class="brand-mark cta-final__sol" data-drift="-24" />
    <div class="wrap above-marks" data-reveal>
      <h2>¿Quieres ser parte del cambio?</h2>
      <p>
        Únete como voluntario, aliado o institución interesada. Juntos podemos
        transformar la manera en que el Perú entiende la adolescencia.
      </p>
      <div class="btn-row">
        <a href="/contacto" class="btn btn-energy">Únete</a>
        <a href="/contacto" class="btn btn-secondary btn-secondary--inverse">Contactar a la agrupación</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---------------- Hero ---------------- */

  .hero {
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
    min-height: min(84dvh, 700px);
  }

  .hero__copy h1 {
    font-size: clamp(2.75rem, 6.5vw, 5.25rem);
    max-width: 14ch;
    margin-bottom: 0.4em;
  }

  .hero__subtext {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    max-width: 46ch;
    margin-bottom: 2rem;
  }

  .hero__visual {
    position: relative;
    height: clamp(300px, 36vw, 480px);
  }

  /* La composición reproduce el ritmo del kit: una figura grande, dos
     medianas y un acento, sin que ninguna caiga sobre el texto. */
  .hero__sol {
    width: 58%;
    top: 2%;
    right: 2%;
  }

  .hero__mancha {
    width: 62%;
    bottom: 0%;
    left: -2%;
    opacity: 0.9;
  }

  .hero__estrellas {
    width: 30%;
    top: 6%;
    left: 12%;
  }

  .hero__rombos {
    width: 26%;
    bottom: 6%;
    right: 6%;
  }

  /* ---------------- Sobre nosotros ---------------- */

  .sobre-nosotros {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .pull-quote {
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: 2.25rem 1.75rem 1.75rem;
    background: var(--brand-beige);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--accent);
  }

  .pull-quote p {
    font-family: var(--font-subtitle);
    font-size: var(--text-lg);
    color: var(--text-primary);
  }

  .pull-quote cite {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    font-style: normal;
  }

  .pull-quote__esquina {
    width: 84px;
    top: 0;
    right: 0;
    opacity: 0.55;
    mix-blend-mode: multiply;
    transform: scaleX(-1);
  }

  /* ---------------- Misión ---------------- */

  .mision {
    position: relative;
    overflow: hidden;
  }

  .mision__statement {
    max-width: 24ch;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
  }

  .mision__marca {
    width: clamp(160px, 20vw, 300px);
    top: -8%;
    right: 4%;
    opacity: 0.75;
  }

  /* ---------------- Valores ---------------- */

  /* La frase con chips es el patrón de untold.site: los valores viven
     dentro de la oración, no en tarjetas sueltas. */
  .valores-frase {
    font-family: var(--font-subtitle);
    font-size: clamp(1.35rem, 2.8vw, 2.15rem);
    line-height: 1.5;
    max-width: 34ch;
    color: var(--text-primary);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .valor-chip {
    display: inline-block;
    padding: 0.1em 0.6em;
    background: var(--accent-energy);
    color: var(--brand-azul-tinta);
    border-radius: var(--radius-sm);
    font-weight: 700;
    white-space: nowrap;
  }

  .valor-chip:nth-of-type(2n) {
    background: var(--brand-celeste);
  }

  .valor {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 2px solid var(--accent-energy);
  }

  .valor h3 {
    font-size: var(--text-xl);
    margin-bottom: 0.2em;
  }

  .valor p {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  /* ---------------- Qué hacemos (bloque de tinta) ---------------- */

  .que-hacemos {
    position: relative;
    overflow: hidden;
  }

  .que-hacemos__esquina {
    width: clamp(180px, 22vw, 340px);
    bottom: 0;
    right: 0;
    opacity: 0.35;
    transform: scaleY(-1);
  }

  .servicios-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .servicio {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-md);
    height: 100%;
    transition: transform 0.3s ease;
  }

  .servicio:hover {
    transform: translateY(-4px);
  }

  .servicio--featured {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .servicio--featured h3 {
    font-size: var(--text-2xl);
  }

  /* Sobre tinta, los destacados son bloques de color pleno y los otros
     dos quedan como contorno: la jerarquía se ve antes de leer. */
  .servicio--naranja {
    background: var(--accent-energy);
  }

  .servicio--beige {
    background: var(--brand-beige);
  }

  .servicio--naranja h3,
  .servicio--naranja p,
  .servicio--beige h3,
  .servicio--beige p {
    color: var(--brand-azul-tinta);
  }

  .servicio--linea {
    border: 1.5px solid rgb(248 244 238 / 0.28);
  }

  .servicio--linea h3 {
    color: var(--brand-celeste);
  }

  /* ---------------- Impacto ---------------- */

  .impacto-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .impacto-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 3px solid var(--accent);
  }

  .impacto-card__icon {
    width: 56px;
    height: 56px;
    margin-bottom: 0.5rem;
  }

  .impacto-card__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* El número es el elemento más grande de la sección: es la evidencia. */
  .impacto-card__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw, 4rem);
    line-height: 1;
    color: var(--accent-energy-deep);
    font-weight: 700;
  }

  .impacto-card__label {
    margin: 0;
    font-family: var(--font-subtitle);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* ---------------- Eventos / pasos numerados ---------------- */

  .eventos__lista {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .pasos__titulo {
    font-size: var(--text-xl);
    color: var(--accent-cool-text);
    margin-bottom: 1.75rem;
  }

  .pasos {
    list-style: none;
    margin: 0 0 clamp(2.5rem, 5vw, 3.5rem);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .paso {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 1rem;
    border-top: 2px solid var(--border-subtle);
  }

  /* El numeral grande es la señal de secuencia de vwlab.io */
  .paso__n {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }

  .paso h4 {
    font-family: var(--font-subtitle);
    font-size: var(--text-base);
    margin: 0;
  }

  .paso p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .eventos__cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .eventos__nota {
    color: var(--text-secondary);
    margin: 0;
    max-width: 48ch;
  }

  /* ---------------- Artículos ---------------- */

  .articulos-seccion {
    position: relative;
  }

  .articulos__marca {
    width: clamp(140px, 16vw, 240px);
    top: 8%;
    right: -2%;
    opacity: 0.5;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
    border-top: 3px solid var(--accent-energy);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .article-card__category {
    font-family: var(--font-subtitle);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-cool-text);
    margin: 0;
  }

  .article-card h3 {
    font-size: var(--text-xl);
  }

  .article-card__author {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  /* ---------------- Testimonios ---------------- */

  .testimonios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .testimonio-card {
    padding: clamp(1.75rem, 3vw, 2.25rem);
    background: var(--surface-raised);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--brand-celeste);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .testimonio-card:nth-child(2) {
    border-left-color: var(--accent-energy);
  }

  .testimonio-card:nth-child(3) {
    border-left-color: var(--accent);
  }

  .testimonio-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lift);
  }

  .testimonio-card__quote {
    margin: 0;
    font-family: var(--font-subtitle);
    font-size: var(--text-lg);
    color: var(--text-primary);
    line-height: 1.55;
  }

  .testimonio-card__author {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
