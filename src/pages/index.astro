---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articulos', ({ data }) => data.published);
const featuredArticles = allArticles
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const upcomingEvents = (await getCollection('eventos', ({ data }) => data.published)).sort(
  (a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf()
);

const valores = [
  { label: 'Evidencia', text: 'Todo lo que comunicamos está respaldado por investigación y datos reales, no por suposiciones.' },
  { label: 'Compromiso', text: 'Actuamos con convicción en defensa activa de los derechos de los adolescentes.' },
  { label: 'Educación', text: 'Creemos que informar transforma personas, instituciones y sociedades.' },
  { label: 'Acción', text: 'Intervenimos activamente en colegios, universidades y espacios sociales para generar cambio real.' },
];

const servicios = [
  { label: 'Difusión en redes sociales', text: 'Contenido basado en evidencia para desmontar mitos sobre la adolescencia.', tint: 'beige', featured: true },
  { label: 'Intervenciones educativas', text: 'Talleres y charlas en colegios y universidades del país.', tint: 'turquesa', featured: false },
  { label: 'Defensa de derechos humanos', text: 'Participación activa en espacios políticos y comunitarios.', tint: 'turquesa', featured: false },
  { label: 'Publicaciones e investigaciones', text: 'Artículos y columnas de opinión con rigor académico.', tint: 'beige', featured: true },
];

const impacto = [
  { label: 'Talleres realizados', value: '40+', icon: '1' },
  { label: 'Estudiantes alcanzados', value: '2,500+', icon: '2' },
  { label: 'Instituciones asociadas', value: '15+', icon: '3' },
  { label: 'Artículos publicados', value: '50+', icon: '4' },
];

const testimonios = [
  { quote: '"ASF cambió mi perspectiva sobre los adolescentes. Finalmente, alguien está hablando con evidencia."', author: 'María, educadora', role: 'Docente' },
  { quote: '"Necesitábamos esta voz. Los adolescentes merecemos ser escuchados sin prejuicios."', author: 'Carlos, 18 años', role: 'Estudiante' },
  { quote: '"Su trabajo es serio, riguroso y profundamente necesario para el Perú."', author: 'Dra. Patricia López', role: 'Psicóloga clínica' },
];
---

<Layout
  title="Inicio"
  description="Agrupación estudiantil peruana que desmitifica la adolescencia con evidencia científica, defensa de derechos y acción social."
>
  <!-- Hero: asymmetric split, geometric visual (sin fotos, per manual de identidad) -->
  <section class="hero wrap">
    <div class="hero__copy" data-reveal>
      <h1>La adolescencia sin mitos, con evidencia.</h1>
      <p class="hero__subtext">
        Somos una agrupación estudiantil peruana dedicada a desmitificar la adolescencia
        mediante investigación rigurosa, defensa activa de derechos y acción social transformadora.
        Trabajamos en colegios, universidades y espacios comunitarios para cambiar la narrativa sobre la juventud peruana.
      </p>
      <div class="btn-row">
        <a href="/proyectos" class="btn btn-primary">Conoce nuestros proyectos</a>
        <a href="/quienes-somos" class="btn btn-secondary">Conoce al equipo</a>
      </div>
    </div>
    <div class="hero__visual" aria-hidden="true">
      <span class="mark-circle hero__c1" style="animation: float 6s ease-in-out infinite;"></span>
      <span class="mark-circle hero__c2" style="animation: float 8s ease-in-out infinite 0.5s;"></span>
      <span class="mark-circle hero__c3" style="animation: float 7s ease-in-out infinite 1s;"></span>
      <svg viewBox="0 0 100 100" class="hero__star" style="animation: rotate 12s linear infinite;">
        <path
          d="M50 2 L61 38 L98 38 L68 60 L79 96 L50 74 L21 96 L32 60 L2 38 L39 38 Z"
          fill="var(--color-azul-profundo)"
        />
      </svg>
    </div>
  </section>

  <!-- Sobre nosotros: texto + cita real del Ideario -->
  <section class="section wrap sobre-nosotros">
    <div data-reveal>
      <h2>Sobre nosotros</h2>
      <p>
        Adolescencias Sin Ficciones nace de la convicción de que la adolescencia es
        una etapa profundamente mal comprendida en el Perú. Somos estudiantes
        universitarios que usamos la evidencia científica, la acción social y la
        defensa activa de derechos para cambiar esa narrativa.
      </p>
      <a href="/quienes-somos" class="btn btn-secondary">Conoce al equipo</a>
    </div>
    <blockquote class="pull-quote" data-reveal>
      <span class="pull-quote__accent"></span>
      <p>&ldquo;Ser adolescente en el Perú es difícil. Y la falta de comprensión sobre esta etapa lo hace aún más complejo.&rdquo;</p>
      <cite>— Ideario de Adolescencias Sin Ficciones</cite>
    </blockquote>
  </section>

  <!-- Misión: editorial manifesto statement -->
  <section class="section section--accent mision">
    <div class="wrap" data-reveal>
      <p class="eyebrow">Nuestra misión</p>
      <h2 class="mision__statement">
        Desmitificar la adolescencia mediante información basada en evidencia,
        promoviendo los derechos humanos de los adolescentes peruanos.
      </h2>
    </div>
  </section>

  <!-- Valores: lista de 4, sin card boxes -->
  <section class="section wrap">
    <div class="section-head" data-reveal>
      <h2>Lo que nos guía</h2>
    </div>
    <div class="grid grid-4 valores">
      {valores.map((valor) => (
        <div class="valor" data-reveal>
          <span class="mark-circle valor__dot"></span>
          <h3>{valor.label}</h3>
          <p>{valor.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Qué hacemos: bento con variación de fondo, algunos servicios destacados -->
  <section class="section section--sunken">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>¿Qué hacemos?</h2>
        <p>Nuestro trabajo se organiza en cuatro pilares estratégicos de cambio social y educativo.</p>
      </div>
      <div class="servicios-grid">
        {servicios.map((servicio) => (
          <div class={`servicio servicio--${servicio.tint} ${servicio.featured ? 'servicio--featured' : ''}`} data-reveal>
            <h3>{servicio.label}</h3>
            <p>{servicio.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Impacto: números con iconos, enfoque visual mejorado -->
  <section class="section wrap impacto">
    <div class="section-head" data-reveal>
      <h2>Nuestro impacto</h2>
      <p>Desde nuestro inicio, hemos alcanzado estudiantes, educadores e instituciones en todo el Perú con trabajo riguroso y transformador.</p>
    </div>
    <div class="impacto-grid">
      {impacto.map((item) => (
        <div class="impacto-card" data-reveal>
          <div class="impacto-card__icon">
            <img src={`/images/icons/${item.icon}.png`} alt={item.label} />
          </div>
          <div class="impacto-card__content">
            <p class="impacto-card__value">{item.value}</p>
            <p class="impacto-card__label">{item.label}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Eventos destacados -->
  <section class="section section--sunken">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>Próximos eventos y actividades</h2>
      </div>
      {upcomingEvents.length === 0 ? (
        <div class="empty-state" data-reveal>
          <p>Todavía no hay eventos publicados. Estamos preparando las próximas actividades: charlas, intervenciones en colegios y universidades.</p>
          <a href="/contacto" class="btn btn-secondary">Proponer una actividad</a>
        </div>
      ) : (
        <div class="grid grid-3">
          {upcomingEvents.slice(0, 3).map((event) => (
            <a class="card" href={`/eventos/${event.slug}`} data-reveal>
              <h3>{event.data.title}</h3>
              <p>{event.data.summary}</p>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Artículos destacados -->
  <section class="section wrap">
    <div class="section-head" data-reveal>
      <h2>Nuestras publicaciones más recientes</h2>
      <p>Investigación, análisis y evidencia sobre la adolescencia peruana.</p>
    </div>
    <div class="grid grid-3">
      {featuredArticles.map((article) => (
        <a class="card article-card" href={`/articulos/${article.slug}`} data-reveal>
          <p class="article-card__category">{article.data.category}</p>
          <h3>{article.data.title}</h3>
          <p>{article.data.excerpt}</p>
          <span class="article-card__author">Por {article.data.author}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Testimonios: voces reales de impacto -->
  <section class="section section--sunken">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>Lo que dicen de nuestro trabajo</h2>
        <p>Educadores, estudiantes e investigadores comparten cómo ASF está transformando conversaciones sobre la adolescencia en el Perú.</p>
      </div>
      <div class="testimonios-grid">
        {testimonios.map((testimonio) => (
          <div class="testimonio-card" data-reveal>
            <p class="testimonio-card__quote">{testimonio.quote}</p>
            <div class="testimonio-card__author">
              <p class="testimonio-card__name">{testimonio.author}</p>
              <p class="testimonio-card__role">{testimonio.role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="section cta-final">
    <div class="wrap" data-reveal>
      <h2>¿Quieres ser parte del cambio?</h2>
      <p>
        Únete como voluntario, aliado o institución interesada. Juntos podemos
        transformar la manera en que el Perú entiende la adolescencia.
      </p>
      <div class="btn-row">
        <a href="/contacto" class="btn btn-primary">Únete</a>
        <a href="/contacto" class="btn btn-secondary btn-secondary--inverse">Contactar a la agrupación</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
    min-height: min(80dvh, 640px);
  }

  .hero__subtext {
    color: var(--text-secondary);
    font-size: var(--text-lg);
    max-width: 42ch;
  }

  .hero__visual {
    position: relative;
    height: clamp(260px, 32vw, 420px);
  }

  .hero__c1 {
    position: absolute;
    width: 55%;
    aspect-ratio: 1;
    background: var(--color-turquesa);
    top: 8%;
    right: 8%;
  }

  .hero__c2 {
    position: absolute;
    width: 32%;
    aspect-ratio: 1;
    background: var(--color-beige);
    bottom: 6%;
    left: 4%;
  }

  .hero__c3 {
    position: absolute;
    width: 18%;
    aspect-ratio: 1;
    border: 3px solid var(--color-azul-oscuro);
    background: transparent;
    top: 4%;
    left: 20%;
  }

  .hero__star {
    position: absolute;
    width: 20%;
    bottom: 18%;
    right: 20%;
  }

  .sobre-nosotros {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .pull-quote {
    position: relative;
    margin: 0;
    padding: 1.75rem;
    padding-top: 2.5rem;
    background: var(--surface-sunken);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }

  .pull-quote__accent {
    position: absolute;
    top: 0;
    left: 1.75rem;
    width: 48px;
    height: 3px;
    background: linear-gradient(90deg, var(--accent-soft) 0%, var(--color-turquesa) 100%);
    border-radius: var(--radius-sm);
  }

  .pull-quote p {
    font-family: var(--font-subtitle);
    font-size: var(--text-lg);
    color: var(--accent-strong);
  }

  .pull-quote cite {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    font-style: normal;
  }

  .mision {
    text-align: left;
  }

  .mision__statement {
    max-width: 30ch;
    font-size: var(--text-3xl);
    color: var(--accent-strong);
  }

  .valor {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .valor__dot {
    width: 12px;
    height: 12px;
    background: var(--accent-soft);
  }

  .servicios-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .servicio {
    padding: clamp(1.5rem, 3vw, 2rem);
    border-radius: var(--radius-md);
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .servicio--featured {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .servicio--featured h3 {
    font-size: var(--text-2xl);
  }

  .servicio:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .servicio--beige {
    background: var(--color-beige);
  }

  .servicio--turquesa {
    background: color-mix(in srgb, var(--color-turquesa) 35%, white);
  }

  .servicio h3 {
    color: var(--accent-strong);
  }

  .impacto-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .impacto-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--surface-sunken);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--accent-soft);
  }

  .impacto-card__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .impacto-card__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .impacto-card__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--accent-strong);
    font-weight: 700;
  }

  .impacto-card__label {
    margin: 0;
    font-family: var(--font-subtitle);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-weight: 500;
  }

  .testimonios-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .testimonio-card {
    padding: clamp(2rem, 3vw, 2.5rem);
    background: #ffffff;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .testimonio-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lift);
  }

  .testimonio-card__quote {
    margin: 0;
    font-family: var(--font-subtitle);
    font-size: var(--text-lg);
    color: var(--accent-strong);
    font-weight: 500;
    line-height: 1.6;
  }

  .testimonio-card__author {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .testimonio-card__name {
    margin: 0;
    font-family: var(--font-subtitle);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--accent-strong);
  }

  .testimonio-card__role {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .impacto__list {
    margin-top: 1.5rem;
    margin-bottom: 1rem;
  }

  .impacto__list p {
    font-family: var(--font-subtitle);
    font-weight: 600;
    color: var(--accent-strong);
    border-top: 2px solid var(--border-subtle);
    padding-top: 1rem;
    margin: 0;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
    max-width: 48ch;
  }

  .empty-state p {
    color: var(--text-secondary);
  }

  .article-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .article-card__category {
    font-family: var(--font-subtitle);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin: 0;
  }

  .article-card__author {
    margin-top: auto;
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .cta-final {
    background: var(--accent-strong);
    color: #ffffff;
    text-align: center;
  }

  .cta-final h2,
  .cta-final p {
    color: #ffffff;
  }

  .cta-final .wrap {
    max-width: 44rem;
  }

  .cta-final p {
    margin-inline: auto;
    color: rgb(255 255 255 / 0.85);
  }

  .cta-final .btn-row {
    justify-content: center;
  }

  .btn-secondary--inverse {
    color: #ffffff;
    border-color: rgb(255 255 255 / 0.6);
  }

  .btn-secondary--inverse:hover {
    background: #ffffff;
    color: var(--accent-strong);
  }

  /* Animaciones */
  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [style*="animation"] {
      animation: none !important;
    }
  }

  @media (max-width: 900px) {
    .hero,
    .sobre-nosotros {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      order: -1;
      height: 220px;
    }

    .servicios-grid {
      grid-template-columns: 1fr;
    }

    .servicio--featured {
      grid-row: span 1;
    }
  }
</style>
