---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const proyectos = (await getCollection('proyectos', ({ data }) => data.published)).sort(
  (a, b) => b.data.year.localeCompare(a.data.year)
);

const beneficios = [
  { label: 'Para los adolescentes', text: 'Espacios de escucha, información basada en evidencia y herramientas para ejercer sus derechos.' },
  { label: 'Para las instituciones', text: 'Talleres diseñados con rigor académico y facilitadores capacitados en desarrollo adolescente.' },
];
---

<Layout
  title="Proyectos"
  description="Intervenciones de impacto en colegios, universidades y espacios sociales impulsadas por Adolescencias Sin Ficciones."
>
  <section class="section wrap page-head">
    <h1>Nuestros proyectos</h1>
    <p>Intervenciones de impacto en colegios, universidades y espacios sociales.</p>
  </section>

  <section class="section wrap">
    {proyectos.length === 0 ? (
      <div class="empty-state" data-reveal>
        <p>
          Estamos documentando nuestros proyectos ejecutados en colegios y
          universidades para presentarlos aquí con su alcance real. Mientras
          tanto, conoce el ideario que guía cada intervención.
        </p>
        <a href="/ideario" class="btn btn-secondary">Ver ideario</a>
      </div>
    ) : (
      <div class="grid grid-3">
        {proyectos.map((proyecto) => (
          <a class="card" href={`/proyectos/${proyecto.slug}`} data-reveal>
            <h3>{proyecto.data.title}</h3>
            <p>{proyecto.data.summary}</p>
            <span class="field-hint">{proyecto.data.institution} · {proyecto.data.year}</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section section--sunken">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2>Por qué importa</h2>
      </div>
      <div class="grid grid-2">
        {beneficios.map((beneficio) => (
          <div class="beneficio" data-reveal>
            <h3>{beneficio.label}</h3>
            <p>{beneficio.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap galeria">
    <div class="section-head" data-reveal>
      <p class="eyebrow">Cobertura</p>
      <h2>Galería de proyectos</h2>
    </div>
    <div class="empty-state" data-reveal>
      <p>Las fotos de cobertura de nuestros proyectos se publicarán aquí conforme se vayan realizando.</p>
    </div>
  </section>

  <section class="section section--accent">
    <div class="wrap contacto-proyectos" data-reveal>
      <h2>¿Tu institución quiere colaborar?</h2>
      <p>
        Si diriges un colegio, universidad o eres parte de una organización
        interesada en facilitar espacios o co-crear proyectos, escríbenos.
      </p>
      <div class="btn-row">
        <a href="/contacto" class="btn btn-primary">Contactar a la agrupación</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head {
    max-width: 44rem;
  }

  .page-head p {
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }

  .beneficio {
    border-top: 2px solid var(--border-subtle);
    padding-top: 1.25rem;
  }

  .contacto-proyectos {
    max-width: 42rem;
  }
</style>
